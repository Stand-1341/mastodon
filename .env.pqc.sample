# =============================================================================
# Mastodon PQC deployment - sample environment for one small VPS
# =============================================================================
#
# BEFORE ANYTHING ELSE: ML-DSA-87 needs OpenSSL 3.5 or newer with an
# ML-DSA-capable provider inside the container that runs Rails, not on the
# host. Account creation is best-effort: on an older runtime it logs a warning
# and succeeds without a signing key, so a broken deploy looks healthy and
# silently issues no badges. Verify the runtime as described in docs/DEPLOY.md
# (section 2, "Verify the runtime OpenSSL 3.5+") before creating the first account.
#
# Usage:
#   cp .env.pqc.sample .env.production
#   chmod 600 .env.production
#   # replace every REPLACE_ME value, then:
#   docker compose -f docker-compose.yml -f docker-compose.pqc.yml config -q
#
# Compose passes env_file values verbatim: do not wrap values in quotes and do
# not put trailing comments on the same line. Every secret below is an obvious
# placeholder, not a usable value.

# -----------------------------------------------------------------------------
# Instance identity
# -----------------------------------------------------------------------------
# Hostname users and remote servers will use. Cannot be changed later without
# breaking federation and every account's identity.
LOCAL_DOMAIN=mastodon.example.invalid
# Serve HTTPS URLs. Leave true in production; Nginx/Caddy terminates TLS.
LOCAL_HTTPS=true
# Only set this if the web UI is served from a different host than LOCAL_DOMAIN.
# WEB_DOMAIN=

# Registration mode is a database setting, not an environment variable. A fresh
# instance defaults to 'none': no signup form at all. After the first admin
# exists, pick one deliberately:
#   bin/tootctl settings registrations approved   # form + your approval
#   bin/tootctl settings registrations open       # anyone with the URL
#   bin/tootctl settings registrations close      # invite links only

# -----------------------------------------------------------------------------
# Rails secrets
# -----------------------------------------------------------------------------
# Signs cookies and sessions. Generate with: openssl rand -hex 64
# Changing it logs every user out; it is not used to encrypt signing keys.
SECRET_KEY_BASE=REPLACE_ME_RUN_openssl_rand_hex_64

# -----------------------------------------------------------------------------
# Active Record Encryption - REQUIRED and unrecoverable if lost
# -----------------------------------------------------------------------------
# These three keys encrypt, among other things, every account's ML-DSA-87
# private signing key. A database backup without these three values cannot
# restore any account's badge. Generate all three with:
#   docker compose -f docker-compose.yml -f docker-compose.pqc.yml \
#     run --rm --no-deps -e SECRET_KEY_BASE_DUMMY=1 web bin/rails db:encryption:init
# Paste the output unchanged (32 characters each). Never rotate them after the
# first boot; doing so makes existing encrypted rows unreadable.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=REPLACE_ME_AR_PRIMARY_KEY_000000
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=REPLACE_ME_AR_DETERMINISTIC_0000
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=REPLACE_ME_AR_SALT_0000000000000
# Non-secret pointer to where the three keys above are escrowed (password
# manager entry, sealed envelope). Reported by `bin/rails pqc:inventory`.
PQC_AR_ENCRYPTION_CUSTODY_POINTER=REPLACE_ME_WHERE_THE_AR_KEYS_ARE_ESCROWED

# -----------------------------------------------------------------------------
# Web Push (browser notifications)
# -----------------------------------------------------------------------------
# Generate both with:
#   docker compose -f docker-compose.yml -f docker-compose.pqc.yml \
#     run --rm --no-deps web bin/rails mastodon:webpush:generate_vapid_key
VAPID_PRIVATE_KEY=REPLACE_ME_VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=REPLACE_ME_VAPID_PUBLIC_KEY

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Service name in Compose. The PQC overlay also forces this value.
DB_HOST=db
DB_PORT=5432
DB_NAME=mastodon_production
DB_USER=mastodon
# Password for the mastodon role. Generate with: openssl rand -hex 24
# Use hex: quotes, '#', and '$' are painful in Compose env files.
DB_PASS=REPLACE_ME_DB_PASSWORD_0000000000000000
# Connection pool per Rails process; keep >= MAX_THREADS.
DB_POOL=5

# Database TLS is configured by docker-compose.pqc.yml for web, streaming, and
# sidekiq, which is why the values below are shown but not active. Listing them
# here with different values would be ignored by Compose's `environment:` block
# and would only mislead the next operator.
#   DB_SSLMODE=verify-full
#   DB_SSLROOTCERT=/run/pqc-postgres-tls/ca.crt
#   PQC_HYBRID_DB_TLS_CA_PATH=/run/pqc-postgres-tls/ca.crt
#   PQC_REQUIRE_HYBRID_DB_TLS=true
# The guard in config/database.yml refuses to boot unless DB_HOST=db,
# DB_SSLMODE=verify-full, and that CA path agree, so do not "helpfully" change
# them. The server certificate and CA come from bin/pqc-tls-init.

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=            # only if you add a password to the redis service

# -----------------------------------------------------------------------------
# Elasticsearch - optional, disabled for a small instance
# -----------------------------------------------------------------------------
ES_ENABLED=false

# -----------------------------------------------------------------------------
# Outgoing mail - required for confirmations, password resets, and reports
# -----------------------------------------------------------------------------
# Use your provider's submission endpoint. Local sendmail is not in the image.
SMTP_SERVER=smtp.example.invalid
SMTP_PORT=587
SMTP_LOGIN=REPLACE_ME_SMTP_USER
SMTP_PASSWORD=REPLACE_ME_SMTP_PASSWORD
SMTP_FROM_ADDRESS=notifications@mastodon.example.invalid
# auto negotiates STARTTLS on 587; use "always" to require it.
SMTP_ENABLE_STARTTLS=auto
# plain is correct for most providers on 587.
SMTP_AUTH_METHOD=plain
# Set to none only for a trusted local relay with a self-signed certificate.
# SMTP_OPENSSL_VERIFY_MODE=peer

# -----------------------------------------------------------------------------
# Media storage
# -----------------------------------------------------------------------------
# Filesystem storage on the VPS (mounted at ./public/system). Leave false; the
# bundled Compose services persist this directory.
S3_ENABLED=false

# -----------------------------------------------------------------------------
# PQC: ActivityPub signing (the badge)
# -----------------------------------------------------------------------------
# Set explicitly. true adds an mldsa87-jcs-2024 proof to outbound activities
# for accounts that have a usable key; false is the RSA-only escape hatch.
# Note: the signing path treats an unset value as enabled, but
# `bin/rails pqc:inventory` reports only the literal "true", so leaving this
# unset produces a misleading inventory. Always set it.
PQC_ACTIVITYPUB_SIGNING=true
# Reject inbound activities that lack a valid ML-DSA-87 proof. Keep false on a
# friends instance: true breaks federation with every RSA-only peer.
PQC_ACTIVITYPUB_REQUIRE_PROOF=false

# -----------------------------------------------------------------------------
# PQC: private media encryption (opt-in, off by default)
# -----------------------------------------------------------------------------
# Owner-only encrypted media API. Off for this deployment: production requires
# AWS KMS (PQC_MEDIA_KMS_KEY_ID plus GenerateDataKey/Decrypt permissions) and a
# persisted PQC_PRIVATE_MEDIA_ROOT, neither of which a small VPS has by default.
PQC_PRIVATE_MEDIA_ENCRYPTION=false
# PQC_MEDIA_KMS_KEY_ID=
# PQC_PRIVATE_MEDIA_ROOT=/mastodon/storage/pqc-private-media

# -----------------------------------------------------------------------------
# Capacity knobs for a 2 vCPU / 4 GB VPS
# -----------------------------------------------------------------------------
# Puma workers. Each worker loads the whole app; 2 is the safe default here.
WEB_CONCURRENCY=2
# Threads per Puma worker and per Sidekiq process.
MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5

# -----------------------------------------------------------------------------
# Retention
# -----------------------------------------------------------------------------
# IPs and sessions are kept for one year by default. Lower these only after
# reading the note in the upstream .env.production.sample about scheduler
# frequency.
IP_RETENTION_PERIOD=31556952
SESSION_RETENTION_PERIOD=31556952
